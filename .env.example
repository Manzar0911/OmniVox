# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Tavily AI Search (for Web Research tool)
TAVILY_API_KEY=tvly-...

# Optional: LangSmith observability (tracing of every agent/tool call).
# Leave unset to run with tracing off. Get a key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=omnivox

# Database Connection (PostgreSQL - e.g. Aiven, Supabase, Neon or local SQLite)
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl=require
# DATABASE_URL=postgresql+asyncpg://avnadmin:YOUR_PASSWORD@pg-11e63a6f-itbeastcoder-0979.a.aivencloud.com:27142/defaultdb?ssl=require

# JWT Authentication Secret Key (Used for Multi-User login & Session management)
# SECRET_KEY=your-random-32-byte-hex-secret-key

# Google OAuth 2.0 Credentials (for 1-click official Gmail integration)
# Create a Web application OAuth client in Google Cloud Console with redirect URI:
# http://localhost:8000/api/integrations/gmail/callback
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback


# Gmail and Notion are NOT configured here - both are reached over MCP and
# authenticate themselves via a token cached on disk by a one-time setup
# command. See README.md for the exact steps:
#   Gmail:  npx @gongrzhe/server-gmail-autoauth-mcp auth
#   Notion: npx -y mcp-remote https://mcp.notion.com/mcp

# Optional: protect webapp/ with HTTP Basic Auth (the browser's native
# login prompt). Leave AUTH_PASSWORD unset to run the web demo with no
# login, e.g. for local development. Required before deploying publicly.
# AUTH_USERNAME=demo
# AUTH_PASSWORD=

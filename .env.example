# AWS Bedrock Configuration
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Tavily AI Search (for Web Research tool)
TAVILY_API_KEY=tvly-...

# Optional: LangSmith observability (tracing of every agent/tool call).
# Leave unset to run with tracing off. Get a key at https://smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=omnivox

# Gmail and Notion are NOT configured here - both are reached over MCP and
# authenticate themselves via a token cached on disk by a one-time setup
# command. See README.md for the exact steps:
#   Gmail:  npx @gongrzhe/server-gmail-autoauth-mcp auth
#   Notion: npx -y mcp-remote https://mcp.notion.com/mcp

# Optional: protect webapp/ with HTTP Basic Auth (the browser's native
# login prompt). Leave AUTH_PASSWORD unset to run the web demo with no
# login, e.g. for local development. Required before deploying publicly.
# AUTH_USERNAME=demo
# AUTH_PASSWORD=
